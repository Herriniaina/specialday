# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL=mysql://${MYSQL_USER:-specialday_dbuser}:${MYSQL_PASSWORD:-specialday_dbpassword}@database:3306/${MYSQL_DATABASE:-specialday_dbname}?serverVersion=${MYSQL_VERSION:-8.0.32}&charset=${MYSQL_CHARSET:-utf8mb4}
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=685397eb508f93d4f9de08e13aeb7568a6703f8285dd929266d62c7d97f6a6f6
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
# In dev this points at the Mailpit container (see compose.override.yaml).
MAILER_DSN=smtp://mailer:1025
MAILER_FROM=no-reply@specialday.local
###< symfony/mailer ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
###< symfony/messenger ###

###> league/flysystem-async-aws-s3 ###
# Bucket used to store uploaded media files (see config/packages/flysystem.yaml).
# Defaults below point at the local MinIO container (see compose.override.yaml).
# Override in .env.local to point at real AWS S3 instead (leave AWS_S3_ENDPOINT
# empty and set AWS_S3_PATH_STYLE_ENDPOINT=false when doing so).
AWS_S3_BUCKET=specialday
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=minioadmin
AWS_S3_SECRET_ACCESS_KEY=minioadmin
# Leave empty to use AWS S3. Set to a S3-compatible endpoint (e.g. MinIO, http://minio:9000) for local dev.
AWS_S3_ENDPOINT=http://minio:9000
# Required (true) for most S3-compatible providers (MinIO, ...), not for real AWS S3.
AWS_S3_PATH_STYLE_ENDPOINT=true
# Optional key prefix applied to every stored object.
AWS_S3_PREFIX=
# Bucket-relative URL browsers can actually reach, used ONLY to sign upload/download URLs handed
# back to the browser (AWS_S3_ENDPOINT above is the Docker-internal address, unreachable from a
# real browser in dev). In prod, leave empty (same default AWS endpoint as AWS_S3_ENDPOINT).
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
###< league/flysystem-async-aws-s3 ###

###> media/video-pipeline ###
# Public bucket that holds transcoded (ffmpeg/MediaConvert) video output. Anonymous read access
# is required (see compose.override.yaml's minio-init) so the browser can play videos directly.
AWS_S3_PUBLIC_BUCKET=specialday-public
# Base URL prefixed to a video's storage path to build its public playback URL (see
# App\Infrastructure\Media\Storage\PublicVideoUrlBuilder). Dev: MinIO path-style bucket URL.
# Prod: the public bucket's URL, or ideally a CDN domain in front of it.
PUBLIC_VIDEO_BASE_URL=http://localhost:9000/specialday-public
###< media/video-pipeline ###

###> imagor ###
# Imagor (shumc/imagor) serves and transforms images on the fly from S3 — see the "imagor"
# service in compose.yaml and the /imagor route in frankenphp/Caddyfile. URLs are HMAC-SHA1
# signed with this secret (see App\Infrastructure\Media\Imagor\ImagorUrlSigner). Generate a real
# random secret per environment and override it in .env.local for prod.
IMAGOR_SECRET=change-me-in-dev
# "1" for MinIO (path-style addressing, dev default), "0" for real AWS S3 in prod.
IMAGOR_S3_FORCE_PATH_STYLE=1
###< imagor ###

###> keycloak ###
# Back-office login (OIDC), see App\Infrastructure\Security\Keycloak. The browser is redirected to
# KEYCLOAK_URL; the php container exchanges the code through KEYCLOAK_INTERNAL_URL (in prod, both
# are usually the same public URL).
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=specialday
KEYCLOAK_ADMIN_CLIENT_ID=specialday-admin
# Real value in .env.local (shared with the keycloak container, see compose.override.yaml).
KEYCLOAK_ADMIN_CLIENT_SECRET=
###< keycloak ###
