<?xml version="1.0" encoding="UTF-8"?>

<!-- https://phpunit.readthedocs.io/en/latest/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Project Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true"
            ignoreIndirectDeprecations="true"
            restrictNotices="true"
            restrictWarnings="true"
    >
        <include>
            <directory>src</directory>
        </include>

        <exclude>
            <!-- Symfony framework bootstrap, no logic of ours to cover -->
            <file>src/Kernel.php</file>
            <!-- EasyAdmin CRUD/dashboard scaffolding: declarative field config, no branching logic -->
            <directory>src/Infrastructure/Admin</directory>
            <!-- Admin login/logout routes: thin glue over KeycloakAuthenticator, which carries the logic -->
            <file>src/Infrastructure/Security/Http/SecurityController.php</file>
            <!-- Doctrine entities that are pure getters/setters (ORM mapping only, no logic) -->
            <file>src/Infrastructure/PrestationCategory/Entity/PrestationCategory.php</file>
            <file>src/Infrastructure/Prestation/Entity/Prestation.php</file>
            <file>src/Infrastructure/Company/Entity/Company.php</file>
            <file>src/Infrastructure/Media/Entity/MediaFile.php</file>
            <file>src/Infrastructure/Subscription/Entity/Subscription.php</file>
            <file>src/Infrastructure/Subscription/Entity/SubscriptionPlan.php</file>
            <!-- Doctrine repositories: QueryBuilder glue with no unit-testable branching without
                 a real database; their callers exercise them through the repository interface
                 mocks in the Application/Http test suites instead -->
            <directory>src/Infrastructure/Company/Repository</directory>
            <directory>src/Infrastructure/Media/Repository</directory>
            <directory>src/Infrastructure/Prestation/Repository</directory>
            <directory>src/Infrastructure/PrestationCategory/Repository</directory>
            <directory>src/Infrastructure/Subscription/Repository</directory>
            <directory>src/Infrastructure/User/Repository</directory>
            <!-- Thin adapters delegating to third-party SDKs/CLIs (AWS SDK, Flysystem, ffmpeg),
                 no branching logic of our own to cover -->
            <directory>src/Infrastructure/Media/Storage</directory>
            <directory>src/Infrastructure/Media/Video</directory>
            <!-- One-line Messenger glue: dispatch/handle delegation, no branching logic -->
            <directory>src/Infrastructure/Media/Messenger</directory>
            <directory>src/Infrastructure/Media/MessageHandler</directory>
            <directory>src/Infrastructure/Media/Message</directory>
            <!-- Trivial JWT failure event-to-response mapping, no branching logic -->
            <file>src/Infrastructure/Shared/Http/EventListeners/JwtAuthenticationFailureListener.php</file>
        </exclude>

        <deprecationTrigger>
            <method>Doctrine\Deprecations\Deprecation::trigger</method>
            <method>Doctrine\Deprecations\Deprecation::delegateTriggerToBackend</method>
            <function>trigger_deprecation</function>
        </deprecationTrigger>
    </source>

    <extensions>
    </extensions>
</phpunit>
