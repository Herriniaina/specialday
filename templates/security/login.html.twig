{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('app.css', constant('EasyCorp\\Bundle\\EasyAdminBundle\\Asset\\AssetPackage::PACKAGE_NAME')) }}">
{% endblock %}

{% block body %}
    <main class="min-vh-100 d-flex align-items-center bg-light py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary text-white fw-bold shadow-sm mb-3" style="width: 3rem; height: 3rem;">SD</div>
                        <h1 class="h3 fw-semibold text-dark mb-2">Specialday Admin</h1>
                        <p class="text-secondary mb-0">Back-office</p>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4 p-sm-5">
                            <div class="mb-4">
                                <h2 class="h5 fw-semibold text-dark mb-1">Connexion impossible</h2>
                                <p class="small text-secondary mb-0">La connexion passe par Keycloak.</p>
                            </div>

                            <div class="alert alert-danger small" role="alert">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </div>

                            <a class="btn btn-primary w-100 fw-semibold" href="{{ path('app_login') }}">
                                Réessayer
                            </a>
                        </div>
                    </div>

                    <p class="text-center text-secondary small mt-4 mb-0">Authorized administrators only</p>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
